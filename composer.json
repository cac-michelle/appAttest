{
    "name": "appattest/reference-backend",
    "description": "Apple App Attest 後端驗證參考實作（PHP 8.1+，零 runtime 相依）",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-pdo_sqlite": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "AppAttest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppAttest\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
